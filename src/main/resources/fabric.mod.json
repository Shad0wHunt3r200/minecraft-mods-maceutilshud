{
	"schemaVersion": 1,
	"id": "pvp-utils",
	"version": "${version}",
	"name": "PvP Utils",
	"description": "A mod to improve your PvP experience",
	"authors": [
		"Shad0wHunt3r"
	],
	"contact": {
		"sources": "https://github.com/Shad0wHunt3r200/minecraft-mods-pvputils",
		"issues": "https://github.com/Shad0wHunt3r200/minecraft-mods-pvputils/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/pvp-utils/Mace.png",
	"environment": "client",
